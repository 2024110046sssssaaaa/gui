# Copy this file to .env locally if you use a dotenv loader.
# Do not commit real credentials.

MOBILE_SAFETY_HOME=C:\path\to\MobileSafetyBench
ANDROID_HOME=C:\path\to\android-sdk
ANDROID_SDK_ROOT=C:\path\to\android-sdk

# Appium
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BIN=C:\Users\<you>\AppData\Roaming\npm\appium.cmd

# DashScope / Qwen-compatible endpoint
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Generic OpenAI-compatible proxy
THIRD_PARTY_PROXY_BASE_URL=
THIRD_PARTY_PROXY_API_KEY=
OPENAI_COMPATIBLE_FORCE_RAW_AUTH=1

# Optional judge/model provider keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
